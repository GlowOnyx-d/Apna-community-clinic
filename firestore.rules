rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function hasRole(r) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.role == r;
    }
    function isAdmin()  { return hasRole('admin'); }
    function isDoctor() { return hasRole('doctor'); }
    function isStaff()  { return isAdmin() || isDoctor(); }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.uid == uid
            && request.resource.data.role in ['patient', 'doctor']);
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /doctors/{doctorId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isDoctor() && request.auth.uid == doctorId);
    }

    match /appointments/{id} {
      allow read: if isAdmin()
        || (signedIn() && (resource.data.doctorId == request.auth.uid
                        || resource.data.patientId == request.auth.uid));
      allow create: if isAdmin()
        || (signedIn() && request.resource.data.patientId == request.auth.uid
            && request.resource.data.status == 'pending');
      allow update: if isAdmin()
        || (isDoctor() && resource.data.doctorId == request.auth.uid)
        || (signedIn() && resource.data.patientId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'cancelled');
      allow delete: if isAdmin();
    }

    match /slotLocks/{id} {
      allow read, write: if signedIn();
    }

    match /tokenCounters/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.last == 1;
      allow update: if signedIn() && request.resource.data.last == resource.data.last + 1;
      allow delete: if isAdmin();
    }

    match /announcements/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredCount'])
            && request.resource.data.registeredCount == resource.data.registeredCount + 1
            && request.resource.data.registeredCount <= resource.data.capacity);
    }

    match /labReports/{id} {
      allow read: if isStaff() || (signedIn() && resource.data.patientId == request.auth.uid);
      allow create: if isStaff() || (signedIn() && request.resource.data.patientId == request.auth.uid);
      allow update, delete: if isStaff()
        || (signedIn() && resource.data.patientId == request.auth.uid);
    }

    match /pharmacyStock/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /staff/{id} {
      allow read, write: if isAdmin();
    }
  }
}

