# Set to true to allow unauthenticated demo logins and local offline preview
VITE_DEMO_MODE=true

# Optional: Override Clinic Email Cloud Function endpoint (defaults to production URL)
# For local dev, Vite automatically proxies /api/sendEmail to local Gmail SMTP
# VITE_CLINIC_EMAIL_FUNCTION_URL=https://us-central1-community-service-142b2.cloudfunctions.net/sendClinicEmail

